@model IEnumerable<webbanhang.Models.Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng của tôi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="fas fa-file-invoice-dollar me-2" style="color:#e94560"></i>Đơn hàng đã mua
        </h4>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm" style="border-radius:20px;">
            <i class="fas fa-arrow-left me-1"></i>Về cửa hàng
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm" style="border-radius:15px; overflow:hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Mã đơn</th>
                            <th scope="col">Ngày đặt hàng</th>
                            <th scope="col" class="text-end">Tổng tiền</th>
                            <th scope="col" class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@order.Id</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end fw-bold" style="color:#e94560;">@order.TotalAmount.ToString("N0") đ</td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2" style="border-radius:20px;">
                                        <i class="fas fa-check-circle me-1"></i>Thành công
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white shadow-sm" style="border-radius:15px;">
            <i class="fas fa-receipt fa-4x mb-3 text-muted"></i>
            <h5 class="fw-bold text-muted">Bạn chưa có đơn hàng nào!</h5>
            <p class="text-muted">Hãy mua sắm sản phẩm đầu tiên của bạn ngay hôm nay.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 mt-2" style="border-radius:30px;">
                <i class="fas fa-store me-2"></i>Xem sản phẩm
            </a>
        </div>
    }
</div>
