@model webbanhang.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm mx-auto p-4 p-md-5" style="max-width: 650px; border-radius: 20px;">
        <div class="mb-4">
            <span style="display:inline-flex; width:80px; height:80px; background:#e8f8f0; border-radius:50%; align-items:center; justify-content:center;">
                <i class="fas fa-check fa-3x text-success"></i>
            </span>
        </div>

        <h3 class="fw-bold text-success mb-2">ĐẶT HÀNG THÀNH CÔNG!</h3>
        <p class="text-muted mb-4">Cảm ơn bạn đã mua hàng. Đơn hàng của bạn đã được lưu an toàn vào cơ sở dữ liệu SQL Server.</p>

        <div class="bg-light p-3 rounded-3 text-start mb-4">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Mã đơn hàng:</span>
                <span class="fw-bold text-primary">#@Model.Id</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Thời gian đặt:</span>
                <span class="fw-semibold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Khách hàng:</span>
                <span class="fw-semibold">@(Model.User?.Username ?? "Khách")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Tổng số tiền:</span>
                <span class="fw-bold fs-5" style="color:#e94560;">@Model.TotalAmount.ToString("N0") đ</span>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-center">
            <a asp-action="Orders" class="btn btn-outline-primary px-4" style="border-radius:30px;">
                <i class="fas fa-list me-1"></i>Xem đơn hàng của tôi
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4" style="border-radius:30px;">
                <i class="fas fa-shopping-bag me-1"></i>Tiếp tục mua hàng
            </a>
        </div>
    </div>
</div>
