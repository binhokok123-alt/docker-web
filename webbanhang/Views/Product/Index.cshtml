@model IEnumerable<webbanhang.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="fas fa-box me-2" style="color:#e94560"></i>Danh sách sản phẩm</h4>
    <a asp-action="Create" class="btn btn-primary px-4" style="border-radius:30px;">
        <i class="fas fa-plus me-2"></i>Thêm sản phẩm
    </a>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px; overflow:hidden;">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Name" style="height:200px; object-fit:cover; width:100%;" />
                }
                else
                {
                    <div style="height:200px; background:#f0f0f0; display:flex; align-items:center; justify-content:center;">
                        <i class="fas fa-image fa-3x text-muted"></i>
                    </div>
                }
                <div class="card-body">
                    <h6 class="fw-bold mb-1">@item.Name</h6>
                    <p class="mb-1" style="color:#e94560; font-weight:600; font-size:1.1rem;">@item.Price.ToString("N0") đ</p>
                    <small class="text-muted"><i class="fas fa-cubes me-1"></i>Tồn kho: @item.Stock</small>
                </div>
                <div class="card-footer bg-white border-0 pb-3">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1"><i class="fas fa-edit me-1"></i>Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"><i class="fas fa-trash me-1"></i>Xóa</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-box-open fa-4x mb-3"></i>
        <p>Chưa có sản phẩm nào. <a asp-action="Create">Thêm ngay</a></p>
    </div>
}
